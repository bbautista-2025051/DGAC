# =============================================================================
# DGAC · Registro de Drones — variables de entorno del módulo Python
# Copie este archivo como .env y complete los valores reales.
# NUNCA suba .env al repositorio.
# =============================================================================

APP_ENV=development
APP_TIMEZONE=America/Guatemala

# -----------------------------------------------------------------------------
# Base de datos MySQL/MariaDB
# NOTA: la conexión la implementa el responsable de la base de datos en
# config/database.py. Estas variables se dejan listas para cuando ello ocurra.
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dgac
DB_USERNAME=dgac_drones
DB_PASSWORD=CAMBIE_ESTA_CLAVE
DB_CHARSET=utf8mb4

# -----------------------------------------------------------------------------
# Correo. Use el mismo servidor/servicio que utiliza la aplicación PHP.
# MAIL_ENCRYPTION: tls | ssl | none
# -----------------------------------------------------------------------------
MAIL_HOST=smtp.dgac.gob.gt
MAIL_PORT=587
MAIL_USERNAME=no-reply@dgac.gob.gt
MAIL_PASSWORD=CAMBIE_ESTA_CLAVE
MAIL_ENCRYPTION=tls
MAIL_FROM=no-reply@dgac.gob.gt
MAIL_FROM_NAME=DGAC - Registro de Drones
MAIL_REPLY_TO=
MAIL_TIMEOUT=20

# Comprobante PDF adjunto (opcional). Vacío = enviar solo el texto/HTML.
MAIL_ATTACH_PDF=1

# -----------------------------------------------------------------------------
# email_worker.py
# -----------------------------------------------------------------------------
WORKER_INTERVAL=60
WORKER_MAX_RETRIES=5
STORAGE_PATH=
