# =============================================================================
# DGAC · Registro de Drones — variables de entorno
# Copie este archivo como .env y complete los valores reales.
# NUNCA suba .env al repositorio.
# =============================================================================

APP_ENV=production
APP_TIMEZONE=America/Guatemala
# URL pública de esta página (sin barra final). Se usa en enlaces y metadatos.
APP_URL=https://dgac.gob.gt/registro-drones

# Orígenes permitidos para CORS. Déjelo vacío si la página y la API comparten
# el mismo origen (caso recomendado). Si necesita varios, sepárelos con coma.
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# MariaDB / MySQL existente de la aplicación.
# No cree una base nueva en producción: use la base que ya tiene la aplicación.
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dgac
DB_USERNAME=dgac_drones
DB_PASSWORD=CAMBIE_ESTA_CLAVE
DB_CHARSET=utf8mb4
# Opcional: ruta al certificado CA si el servidor exige TLS.
DB_SSL_CA=

# -----------------------------------------------------------------------------
# Correo. Use el mismo servidor/servicio que ya utiliza la aplicación.
# MAIL_TRANSPORT: smtp | mail
#   smtp  = conexión SMTP directa (recomendado; soporta TLS/SSL y autenticación)
#   mail  = función mail() de PHP (requiere un MTA configurado en el servidor)
# MAIL_ENCRYPTION: tls | ssl | none
# -----------------------------------------------------------------------------
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.dgac.gob.gt
MAIL_PORT=587
MAIL_USERNAME=no-reply@dgac.gob.gt
MAIL_PASSWORD=CAMBIE_ESTA_CLAVE
MAIL_ENCRYPTION=tls
MAIL_FROM=no-reply@dgac.gob.gt
MAIL_FROM_NAME=DGAC - Registro de Drones
MAIL_REPLY_TO=
MAIL_TIMEOUT=20

# -----------------------------------------------------------------------------
# Operación
# -----------------------------------------------------------------------------
# Ruta absoluta para PDFs y logs. Si se deja vacío: <registro-drones>/storage
STORAGE_PATH=
# Máximo de registros por IP dentro de la ventana (segundos).
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=3600
# Máximo de reintentos de correo por registro.
MAIL_MAX_RETRIES=5
# Días que se conserva el PDF generado (0 = no borrar).
PDF_RETENTION_DAYS=365
